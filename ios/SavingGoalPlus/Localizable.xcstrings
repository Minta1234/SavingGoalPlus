    "This backup contains %lld goals and %lld transactions. Restoring replaces the current goals and transactions.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์นี้มี %lld เป้าหมายและ %lld รายการ การกู้คืนจะแทนที่เป้าหมายและรายการปัจจุบัน"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップには %lld 個の目標と %lld 件の取引が含まれています。復元すると現在のデータが置き換わります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта копия содержит %lld целей и %lld операций. Восстановление заменит текущие цели и операции."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "此备份包含 %lld 个目标和 %lld 条交易。恢复将替换现有的目标和明细。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia contiene %lld objetivos y %lld transacciones. Restaurar reemplazará los datos actuales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde contient %lld objectifs et %lld transactions. La restauration remplace les données actuelles."
          }
        }
      }
    },
    "This changes how amounts are labeled. Amounts are not converted.": {
      "extractionState": "manual",
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนเฉพาะสัญลักษณ์ที่แสดง โดยไม่แปลงจำนวนเงิน"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額の表記記号のみが変更されます。為替換算は行われません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это изменяет только отображаемый символ. Конвертация валют не производится."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这仅更改金额的显示符号，不会进行汇率换算。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solo cambia el símbolo mostrado. Los importes no se convierten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela modifie uniquement le symbole affiché. Les montants ne sont pas convertis."
          }
        }
      }
    },
